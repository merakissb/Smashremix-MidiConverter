# --- Entornos virtuales (pesados, específicos de la máquina, regenerables) ---
# Se reconstruyen con: pip install -r requirements.txt  (y requirements-separator.txt)
venv/
venv-separator/
.venv/
env/

# --- Caché de Python ---
__pycache__/
*.py[cod]
*.egg-info/

# --- Caché de huellas tímbricas del .sf2 (se regenera solo) ---
.timbre_cache.json

# --- Salidas y archivos intermedios (regenerables) ---
*.mid
*.midi
*.wav
*_stems/

# --- Audio de entrada (no versionar: suele tener copyright y es pesado) ---
*.mp3
*.flac
*.m4a
*.ogg

# --- Pesos de modelos descargados (Demucs, RoFormer) ---
*.ckpt
*.onnx
*.pth
*.th

# --- SoundFont del juego (samples con copyright de Nintendo) ---
# Se usa en local para la selección automática de instrumentos, pero NO se
# redistribuye: cada quien lo saca de su propia copia de Smash Remix.
# Ver la sección "Selección automática de instrumentos" del README.
*.sf2
sf2/

# --- Configuración local de Claude Code (no compartir) ---
.claude/settings.local.json

# --- Varios del sistema / editores ---
.DS_Store
Thumbs.db
.idea/
.vscode/
